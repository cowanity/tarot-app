+/* 8c F7: dock outside header; five navigation columns at every width. */
+.main-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2px;white-space:nowrap;min-width:0;font-size:clamp(13px,1.1vw,16px)}
+.main-nav a{min-width:0;white-space:nowrap;font-size:inherit;padding:8px 4px}
+@media(min-width:850px){.main-nav{width:min(55%,560px);min-width:390px}}
+.ambient-dock{position:fixed;top:auto;right:max(12px,env(safe-area-inset-right));bottom:calc(12px + env(safe-area-inset-bottom));opacity:.9;transform:none;padding:4px;background:#171021cc}
+.ambient-dock>.effects-toggle,.ambient-dock>.ambient-speaker{width:44px;height:44px;min-width:44px;min-height:44px;padding:0}
+body:has(dialog[open]) .ambient-dock,body:has([role=dialog][aria-modal=true]) .ambient-dock{display:none}
+.app-main.stage,.app-footer.stage{padding-bottom:calc(88px + env(safe-area-inset-bottom))}
