+import {useEffect,useRef,type ReactNode} from 'react';
+import {createPortal} from 'react-dom';
+/** Native modal supplies focus trapping/inert background; caller focus is restored. */
+export function BottomSheet({title,children,onClose}:{title:string;children:ReactNode;onClose:()=>void}){
+ const ref=useRef<HTMLDialogElement>(null),start=useRef<number|null>(null),close=useRef(onClose);close.current=onClose;
+ useEffect(()=>{const previous=document.activeElement as HTMLElement|null;const dialog=ref.current;dialog?.showModal();return()=>{dialog?.close();previous?.focus({preventScroll:true});};},[]);
+ return createPortal(<dialog ref={ref} className="bottom-sheet" aria-label={title} onCancel={e=>{e.preventDefault();close.current();}} onClick={e=>{if(e.target===e.currentTarget)close.current();}}><div className="sheet-content">
+ <header onPointerDown={e=>{start.current=e.clientY;}} onPointerUp={e=>{if(start.current!==null&&e.clientY-start.current>70)close.current();start.current=null;}}><span className="sheet-handle" aria-hidden="true"/><h2>{title}</h2><button onClick={onClose} aria-label="Đóng chi tiết lá bài">Đóng</button></header>{children}</div></dialog>,document.body);
+}
