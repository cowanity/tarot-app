+import {expect,test} from 'vitest';
+import spreads from '../data/spreads.json';
+import {computeSpreadLayout,rotatedBounds} from './spreadLayout';
+for(const W of [320,360,390,430,440,768,1024,1440])for(const H of [568,667,844,932,1000])for(const spread of spreads)test(`${spread.id} ${W}x${H}`,()=>{
+ const l=computeSpreadLayout(spread.id,W,H);expect(l.board.w).toBeLessThanOrEqual(W);expect(l.board.h).toBeLessThanOrEqual(H);
+ for(const c of l.cards){const b=rotatedBounds(c);expect(b.x).toBeGreaterThanOrEqual(-.001);expect(b.y).toBeGreaterThanOrEqual(-.001);expect(b.x+b.w).toBeLessThanOrEqual(W+.001);expect(b.y+b.h).toBeLessThanOrEqual(H+.001);if(W>=360)expect(c.w).toBeGreaterThanOrEqual(44);
+ for(const other of l.cards.filter(o=>o.id>c.id)){const d=rotatedBounds(other),overlap=b.x<d.x+d.w-.001&&b.x+b.w>d.x+.001&&b.y<d.y+d.h-.001&&b.y+b.h>d.y+.001;if(spread.id==='celtic-cross'&&c.id===1&&other.id===2){expect(overlap).toBe(true);expect(other.z).toBeGreaterThan(c.z);}else expect(overlap).toBe(false);}}
+ if(spread.id==='celtic-cross'){const b=rotatedBounds(l.cards[1]);for(const c of l.cards.slice(2))expect(c.x+c.w/2>b.x&&c.x+c.w/2<b.x+b.w&&c.y+c.h/2>b.y&&c.y+c.h/2<b.y+b.h).toBe(false);expect(l.cards[9].y).toBeLessThan(l.cards[6].y);}
+});
+test('tiny, zero, invalid boxes stay finite',()=>{for(const n of [0,1,10,NaN,Infinity,-5]){const l=computeSpreadLayout('celtic-cross',n,n);expect(JSON.stringify(l)).not.toContain('null');for(const c of l.cards)expect(Object.values(c).every(Number.isFinite)).toBe(true);}});
diff --git a/src/lib/spreadLayout.ts b/src/lib/spreadLayout.ts
new file mode 100644
index 0000000..06be949
--- /dev/null
+++ b/src/lib/spreadLayout.ts
@@ -0,0 +1,21 @@
+import spreads from '../data/spreads.json';
+export const CARD_RATIO=.585;
+export interface LayoutCard {id:number;x:number;y:number;w:number;h:number;rotate:number;z:number}
+const finite=(n:number)=>Number.isFinite(n)?Math.max(0,n):0;
+/** Coordinates describe unrotated boxes; rotation is around their centres. */
+export function computeSpreadLayout(spreadId:string,boxW:number,boxH:number,opts:{gap?:number;maxCardW?:number}={}){
+ const W=finite(boxW),H=finite(boxH),spread=spreads.find(s=>s.id===spreadId)??spreads[0];
+ const cross=spread.id==='celtic-cross',cols=cross?4:spread.card_count,rows=cross?4:1;
+ const gap=Math.min(finite(opts.gap??10),W/(cols*4),H/(rows*4));
+ const label=W>=600?Math.min(26,H/(rows*8)):0;
+ const w=Math.max(0,Math.min(opts.maxCardW??180,(W-gap*(cols+1))/cols,((H-gap*(rows+1))/rows-label)*CARD_RATIO));
+ const h=w/CARD_RATIO,stepX=w+gap,stepY=h+label+gap;
+ const left=(W-(cols*w+(cols-1)*gap))/2,top=(H-(rows*(h+label)+(rows-1)*gap))/2;
+ const xy=[[1,1],[1,1],[1,2],[0,1],[1,0],[2,1],[3,3],[3,2],[3,1],[3,0]];
+ const cards=spread.positions.map((p,i)=>{
+  const [col,row]=cross?xy[i]:[i,0],scale=cross&&i===1?Math.min(1,Math.max(CARD_RATIO,W>=360&&H>=568?44/Math.max(w,1):0)):1;
+  return {id:p.number,x:left+col*stepX+(w-w*scale)/2,y:top+row*stepY+(h-h*scale)/2,w:w*scale,h:h*scale,rotate:cross&&i===1?90:0,z:cross&&i===1?2:1};
+ });
+ return {cards,board:{w:W,h:H},cardScale:w/120,controls:cross?{x:left,y:top+3*stepY,w:3*w+2*gap,h:h+label}:null};
+}
+export function rotatedBounds(c:LayoutCard){const swap=c.rotate%180!==0,w=swap?c.h:c.w,h=swap?c.w:c.h;return{x:c.x+(c.w-w)/2,y:c.y+(c.h-h)/2,w,h};}
