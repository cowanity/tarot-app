@@ -0,0 +1,10 @@
+export type FailureReason='rate_limited'|'daily_budget'|'provider_429'|'provider_5xx'|'provider_network'|'timeout'|'guard_blocked'|'bad_request';
+/** Only whitelisted metadata, never an arbitrary exception message. */
+export function failureReason(status:number,code?:string|null,guard=false):FailureReason{
+ if(status>=400&&status<500&&status!==429)return 'bad_request';
+ if(guard)return 'guard_blocked';
+ if(/TIMEOUT|ABORTED/.test(code??''))return 'timeout';
+ if(/HTTP_429/.test(code??''))return 'provider_429';
+ if(/HTTP_5\d\d/.test(code??'')||code==='AI_BUSY')return 'provider_5xx';
+ return 'provider_network';
+}
